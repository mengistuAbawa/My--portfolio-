# Admin password used by the private upload page
ADMIN_PASSWORD=replace-with-a-strong-password
# Random secret used to sign the httpOnly admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-secret
# Optional Google OAuth credentials. Set the callback URL in Google Cloud to:
# https://your-domain.example/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
